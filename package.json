{
  "name": "@sudobility/writing_core",
  "version": "0.0.1",
  "description": "Headless, platform-free writing engine for screenplays, stage plays and manuscripts: collaborative document model (Yjs), templates, editing commands, SmartType and per-session undo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "templates:generate": "bun scripts/generate-builtin-templates.ts",
    "hash:vectors": "bun scripts/generate-hash-vectors.ts",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "files": ["dist/**/*", "CLAUDE.md"],
  "keywords": ["screenwriting", "screenplay", "yjs", "collaborative", "fadewright"],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "fast-xml-parser": "^5.11.1",
    "globals": "^16.4.0",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnqh/writing_core.git"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "yjs": "^13.6.32",
    "zod": "^4.6.5"
  }
}
